[Desktop Entry]
Type=Application
Version=1.0
Name=Chrome Multi Session
GenericName=Multi-user Chrome launcher
Comment=Launch one isolated, auto-logged-in Chrome window per test user
Exec=/usr/bin/chrome-multi-session-gui
Icon=chrome-multi-session
Terminal=false
Categories=Development;Utility;
Keywords=chrome;session;profile;testing;automation;playwright;cdp;
StartupNotify=true
StartupWMClass=chrome-multi-session-gui
